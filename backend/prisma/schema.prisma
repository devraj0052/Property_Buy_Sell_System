datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  engineType    = "library"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x", "debian-openssl-3.0.x"]
}

// ---------------------------------------------------------
// Users & Roles
// ---------------------------------------------------------

model Role {
  id          Int          @id @default(autoincrement())
  name        String       @unique // e.g., USER, AGENT, ADMIN
  permissions Permission[]
  users       User[]
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Permission {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  roles       Role[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model User {
  id            String    @id @default(uuid())
  roleId        Int
  role          Role      @relation(fields: [roleId], references: [id])
  email         String    @unique
  phone         String?   @unique
  password      String?
  firstName     String
  lastName      String
  profileImage  String?
  isVerified    Boolean   @default(false)
  googleId      String?   @unique
  status        String    @default("ACTIVE") // ACTIVE, SUSPENDED, BANNED
  
  // Relations
  admin         Admin?
  agent         Agent?
  properties    Property[]
  favorites     Favorite[]
  compares      CompareProperty[]
  reviews       Review[]
  ratings       Rating[]
  appointments  Appointment[]
  visits        Visit[]
  inquiries     Inquiry[]
  transactions  Transaction[]
  payments      Payment[]
  activityLogs  ActivityLog[]
  auditLogs     AuditLog[]
  failedLoginAttempts Int       @default(0)
  accountLockedUntil  DateTime?
  lastLogin           DateTime?
  lastLoginIP         String?
  lastSeen            DateTime?
  isOnline            Boolean   @default(false)
  
  notifications Notification[]
  loginHistory  LoginHistory[]
  refreshTokens RefreshToken[]
  subscriptions Subscription[]
  
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Admin {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  level       Int      @default(1)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Agent {
  id             String   @id @default(uuid())
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id])
  companyName    String?
  licenseNumber  String?
  experienceYears Int?
  about          String?  @db.Text
  facebookUrl    String?
  twitterUrl     String?
  linkedinUrl    String?
  instagramUrl   String?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

// ---------------------------------------------------------
// Location
// ---------------------------------------------------------

model Country {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  code      String   @unique
  states    State[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model State {
  id        Int      @id @default(autoincrement())
  name      String
  countryId Int
  country   Country  @relation(fields: [countryId], references: [id])
  cities    City[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model City {
  id        Int        @id @default(autoincrement())
  name      String
  stateId   Int
  state     State      @relation(fields: [stateId], references: [id])
  locations Location[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model Location {
  id          Int        @id @default(autoincrement())
  name        String
  cityId      Int
  city        City       @relation(fields: [cityId], references: [id])
  zipCode     String?
  latitude    Float?
  longitude   Float?
  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// ---------------------------------------------------------
// Property Core
// ---------------------------------------------------------

model PropertyCategory {
  id          Int        @id @default(autoincrement())
  name        String     @unique // e.g., Residential, Commercial
  slug        String     @unique
  icon        String?
  types       PropertyType[]
  properties  Property[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model PropertyType {
  id          Int              @id @default(autoincrement())
  categoryId  Int
  category    PropertyCategory @relation(fields: [categoryId], references: [id])
  name        String           // e.g., Apartment, Villa, Office
  slug        String           @unique
  properties  Property[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

model Amenity {
  id         Int               @id @default(autoincrement())
  name       String            @unique
  icon       String?
  properties PropertyAmenity[]
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt
}

model PropertyAmenity {
  propertyId Int
  amenityId  Int
  property   Property @relation(fields: [propertyId], references: [id])
  amenity    Amenity  @relation(fields: [amenityId], references: [id])
  @@id([propertyId, amenityId])
}

model Property {
  id              Int              @id @default(autoincrement())
  title           String
  slug            String           @unique
  description     String           @db.Text
  price           Decimal          @db.Decimal(12, 2)
  currency        String           @default("USD")
  purpose         String           // BUY, RENT
  status          String           @default("PENDING") // PENDING, ACTIVE, SOLD, RENTED
  
  userId          String
  user            User             @relation(fields: [userId], references: [id])
  categoryId      Int
  category        PropertyCategory @relation(fields: [categoryId], references: [id])
  typeId          Int
  type            PropertyType     @relation(fields: [typeId], references: [id])
  locationId      Int
  location        Location         @relation(fields: [locationId], references: [id])
  
  address         String
  bedrooms        Int?
  bathrooms       Int?
  garages         Int?
  areaSize        Float
  areaUnit        String           @default("sqft")
  buildYear       Int?
  videoUrl        String?
  virtualTourUrl  String?
  
  isFeatured      Boolean          @default(false)
  viewsCount      Int              @default(0)
  
  images          PropertyImage[]
  videos          PropertyVideo[]
  documents       PropertyDocument[]
  amenities       PropertyAmenity[]
  favorites       Favorite[]
  compares        CompareProperty[]
  reviews         Review[]
  ratings         Rating[]
  appointments    Appointment[]
  visits          Visit[]
  inquiries       Inquiry[]
  transactions    Transaction[]

  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

// ---------------------------------------------------------
// Property Media & Docs
// ---------------------------------------------------------

model PropertyImage {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
  url        String
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PropertyVideo {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
  url        String
  title      String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model PropertyDocument {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
  url        String
  title      String
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

// ---------------------------------------------------------
// User Interactions
// ---------------------------------------------------------

model Favorite {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())
  @@unique([userId, propertyId])
}

model CompareProperty {
  id         Int      @id @default(autoincrement())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
  createdAt  DateTime @default(now())
  @@unique([userId, propertyId])
}

model Review {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  content    String   @db.Text
  rating     Int      @default(5)
  isApproved Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Rating {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  score      Int
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([userId, propertyId])
}

model Appointment {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  date       DateTime
  status     String   @default("PENDING") // PENDING, CONFIRMED, CANCELLED, COMPLETED
  message    String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Visit {
  id         Int      @id @default(autoincrement())
  propertyId Int
  property   Property @relation(fields: [propertyId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  ipAddress  String?
  createdAt  DateTime @default(now())
}

model Inquiry {
  id         Int      @id @default(autoincrement())
  propertyId Int?
  property   Property? @relation(fields: [propertyId], references: [id])
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])
  name       String
  email      String
  phone      String
  message    String   @db.Text
  status     String   @default("NEW") // NEW, READ, REPLIED
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ContactMessage {
  id        Int      @id @default(autoincrement())
  name      String
  email     String
  subject   String
  message   String   @db.Text
  status    String   @default("NEW") // NEW, READ, REPLIED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------
// Security & Notifications
// ---------------------------------------------------------

model Notification {
  id        Int      @id @default(autoincrement())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  title     String
  message   String   @db.Text
  type      String   // SYSTEM, PROPERTY, MESSAGE
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  identifier String  // email or phone
  otp       String
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailVerification {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model PasswordReset {
  id        Int      @id @default(autoincrement())
  email     String
  token     String   @unique
  expiresAt DateTime
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        Int      @id @default(autoincrement())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String
  details   String?  @db.Text
  ipAddress String?
  createdAt DateTime @default(now())
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  entity    String   // e.g., PROPERTY, USER
  entityId  String
  action    String   // CREATE, UPDATE, DELETE
  oldData   Json?
  newData   Json?
  createdAt DateTime @default(now())
}

// ---------------------------------------------------------
// Auth Extensions & Auditing
// ---------------------------------------------------------

model LoginHistory {
  id            Int      @id @default(autoincrement())
  userId        String
  user          User     @relation(fields: [userId], references: [id])
  ipAddress     String?
  country       String?
  city          String?
  device        String?
  browser       String?
  os            String?
  status        String   // SUCCESS, FAILED, LOCKED
  failureReason String?
  portalType    String?  // Customer, Agent, Admin, SuperAdmin
  loginTime     DateTime @default(now())
  logoutTime    DateTime?
}

model RefreshToken {
  id              Int      @id @default(autoincrement())
  token           String   @db.VarChar(512) @unique
  sessionId       String   @unique @default(uuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  ipAddress       String?
  country         String?
  city            String?
  browser         String?
  browserVersion  String?
  os              String?
  device          String?
  platform        String?
  latitude        Float?
  longitude       Float?
  userAgent       String?  @db.Text
  lastActive      DateTime @default(now())
  expiresAt       DateTime
  isCurrentSession Boolean @default(true)
  isRevoked       Boolean  @default(false)
  replacedByToken String?
  createdAt       DateTime @default(now())
}

model Subscription {
  id               Int      @id @default(autoincrement())
  userId           String
  user             User     @relation(fields: [userId], references: [id])
  planName         String   // BASIC, PREMIUM, PRO
  status           String   // ACTIVE, CANCELLED, EXPIRED
  currentPeriodEnd DateTime
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// ---------------------------------------------------------
// Content & Misc
// ---------------------------------------------------------

model BlogCategory {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  slug      String   @unique
  blogs     Blog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Blog {
  id          Int          @id @default(autoincrement())
  categoryId  Int
  category    BlogCategory @relation(fields: [categoryId], references: [id])
  title       String
  slug        String       @unique
  content     String       @db.Text
  image       String?
  author      String
  isPublished Boolean      @default(true)
  viewsCount  Int          @default(0)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
}

model Faq {
  id        Int      @id @default(autoincrement())
  question  String
  answer    String   @db.Text
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Testimonial {
  id          Int      @id @default(autoincrement())
  name        String
  designation String?
  content     String   @db.Text
  image       String?
  rating      Int      @default(5)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Banner {
  id        Int      @id @default(autoincrement())
  title     String?
  subtitle  String?
  imageUrl  String
  linkUrl   String?
  position  String   // e.g., HOME_HERO, SIDEBAR
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Settings {
  id          Int      @id @default(autoincrement())
  key         String   @unique
  value       String   @db.Text
  description String?
  updatedAt   DateTime @updatedAt
}

// ---------------------------------------------------------
// Billing & Transactions
// ---------------------------------------------------------

model Transaction {
  id            Int       @id @default(autoincrement())
  userId        String
  user          User      @relation(fields: [userId], references: [id])
  propertyId    Int?
  property      Property? @relation(fields: [propertyId], references: [id])
  amount        Decimal   @db.Decimal(12, 2)
  currency      String    @default("USD")
  status        String    // PENDING, SUCCESS, FAILED
  type          String    // COMMISSION, SUBSCRIPTION, FEATURED_FEE
  referenceId   String?   @unique
  payments      Payment[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Payment {
  id            Int         @id @default(autoincrement())
  transactionId Int
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  userId        String
  user          User        @relation(fields: [userId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  method        String      // STRIPE, PAYPAL, BANK_TRANSFER
  gatewayRef    String?
  status        String      // SUCCESS, FAILED, REFUNDED
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}
